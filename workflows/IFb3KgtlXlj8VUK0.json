          "id": "KBLGEFMAR7Y26lSV",
          "name": "Personal"
        }
      },
      "notes": "Select OpenAI credential + chat model."
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "Search the team's engineering and infrastructure standards (tagging, encryption, security, destructive-change, naming, IAM) for guidance relevant to this code change.",
        "pineconeIndex": {
          "__rl": true,
          "mode": "list",
          "value": "devops-kb",
