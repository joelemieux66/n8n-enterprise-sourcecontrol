{
  "id": "IFb3KgtlXlj8VUK0",
  "name": "DevOps — GitHub PR Review (multi-agent)",
  "nodes": [
    {
      "parameters": {
        "content": "### DevOps demo — GitHub PR review\nAll-native GitHub. When a PR opens, an AI reviewer reads the diff, grounds against team standards, and posts a review comment back on the PR.\n\n**Flow:** GitHub Trigger (pull_request) → Get PR diff (GitHub) → PR Reviewer agent (grounds via `search_infra_docs`) → structured verdict → Create Comment on the PR.\n\n**Demo:** open a PR in the repo → within seconds an AI review comment appears citing your standards.\n\n**Wire-up:** GitHub credential (access token) on the 3 GitHub nodes; set owner/repo on the trigger; OpenAI + Pinecone on the reviewer. Reuses the `devops-kb` standards.",
        "height": 520,
        "width": 400,
        "color": 4
      },
      "id": "sticky_overview",
      "name": "Sticky: Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -576,
        -96
      ]
    },
    {
      "id": "get_diff",
      "name": "Get PR diff (BROKEN)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        208,
        64
      ],
      "parameters": {}
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Review this pull request diff.\n\n--- DIFF ---\n{{ $json.diff }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a senior engineer reviewing a pull request. Use search_infra_docs to ground your review in the team's standards (tagging, security, encryption, destructive-change, naming, IAM). Review the diff for: correctness risks, security issues, standards/policy violations, and destructive or risky changes. Decide approve / comment / request_changes. Be specific and cite the standard when flagging. Keep it concise and actionable."
        }
      },
      "id": "reviewer",
      "name": "PR Reviewer",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        448,
