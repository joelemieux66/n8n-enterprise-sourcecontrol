          "id": "KBLGEFMAR7Y26lSV",
          "name": "Personal"
        }
      },
      "notes": "Select OpenAI credential. text-embedding-3-small @ 1024 to match devops-kb."
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"decision\": { \"type\": \"string\", \"enum\": [\"approve\", \"comment\", \"request_changes\"] },\n    \"summary\": { \"type\": \"string\" },\n    \"findings\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n  },\n  \"required\": [\"decision\", \"summary\", \"findings\"]\n}",
        "autoFix": true
      },
      "id": "verdict_parser",
