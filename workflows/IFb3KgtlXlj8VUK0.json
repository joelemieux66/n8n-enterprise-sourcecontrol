          "id": "bdIGPcclXfSxFgf7",
          "name": "Pinecone"
        }
      },
      "notes": "Select Pinecone credential. Reuses index devops-kb (the infra standards)."
    },
    {
      "parameters": {
        "options": {
          "dimensions": 1024
        }
      },
      "id": "infra_embeddings",
      "name": "Infra Docs Embeddings (OpenAI)",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [
